# Copy to .env for local overrides. Dev defaults need none of these.

# --- Infrastructure ---
# ROADSENSE_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/roadsense
# ROADSENSE_STORAGE_DIR=./_storage

# --- Production worker (Redis/RQ) ---
# ROADSENSE_USE_RQ=1
# ROADSENSE_REDIS_URL=redis://localhost:6379

# --- Tuning (see app/config.py for all knobs) ---
# ROADSENSE_H3_RESOLUTION=12
# ROADSENSE_DECAY_HALFLIFE_DAYS=90
