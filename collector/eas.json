{
  "cli": {
    "version": ">= 5.9.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "//": "One-command installable APK for sideloading / sharing a link.",
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "production": {
      "//": "AAB for the Play Store.",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "production": {}
  }
}
